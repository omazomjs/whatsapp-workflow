# ---- Conexion a SQL Server ----
# Si el servidor tiene instancia: SERVIDOR\INSTANCIA
DB_SERVER=192.168.1.212\SQL2008
DB_USER=wa_bot
# Si se deja VACIA, el worker la pide por consola al arrancar
DB_PASSWORD=
DB_DATABASE=GesMensajeria
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ---- Cola / polling ----
OUTBOX_TABLE=WhatsAppOutbox
POLL_INTERVAL_MS=30000
BATCH_SIZE=5
# Reintentos: al fallar un envio se reintenta hasta OUTBOX_MAX_RETRY veces.
# Una fila en estado SENDING mas antigua de OUTBOX_STALE_MINUTES se considera
# de un proceso caido y se vuelve a tomar (evita quedar atascada).
OUTBOX_MAX_RETRY=3
OUTBOX_STALE_MINUTES=2

# ---- Fuente de datos (SOLO LECTURA) ----
# BD de negocio donde se leen los datos. El usuario DB_USER solo lee aqui.
# SRC_ENABLED=false -> el worker NO envia mensaje por factura (solo resumen diario)
SRC_ENABLED=false
SRC_DATABASE=REFact
SRC_TABLE=dbo.Registro
SRC_ID_COLUMN=IDRegistro
SRC_WHERE=
SRC_PHONE_COLUMN=Telefono
SRC_MESSAGE_TEMPLATE=

# ---- Resumen diario ----
RESUMEN_ENABLED=true
RESUMEN_HORA=23
RESUMEN_MINUTO=0
RESUMEN_RECIPIENTS=34660400537
# Si el worker estuvo caido, al volver recupera los dias perdidos (solo los que
# tuvieron movimientos), hasta los N dias anteriores. 0 = sin recuperacion.
RESUMEN_CATCHUP_DAYS=7

# ---- WhatsApp ----
# Ruta de Chrome instalado (opcional; si no se indica, se usa el Chrome de Puppeteer)
WA_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Puerto para ver el QR en el navegador (0 = desactivado). Util en servidores sin terminal.
WA_QR_PORT=8080

# ---- Panel web (opcional) ----
# Interfaz para ver cola/logs, estado, dashboard y gestionar contactos.
# WEB_USER vacio -> basta con la contrasena.
WEB_PORT=3000
WEB_USER=
WEB_PASSWORD=<cambiar_por_una_contrasena_larga>
WEB_SESSION_SECRET=<cadena_aleatoria_larga_de_32_mas_caracteres>
# HTTPS con certificado firmado por la CA de la empresa (generar con XCA).
# Si se indican las rutas, el panel sirve por HTTPS en WEB_HTTPS_PORT.
# SANs del certificado: localhost + IP LAN del servidor (ej. 192.168.1.223).
WEB_SSL_CERT=
WEB_SSL_KEY=
WEB_HTTPS_PORT=3443

# ---- Alarmas programadas (Fase 1) ----
# Worker verifica las alarmas cada ALARMAS_INTERVAL_S segundos.
# Solo evalua las que tienen Hora <= ahora y cuyo dia de la semana coincide.
# ALARMAS_ENABLED se puede poner a false para desactivar temporalmente.
ALARMAS_ENABLED=true
ALARMAS_INTERVAL_S=60
# Cuantas ejecuciones por alarma conservar en historial (0 = sin limite).
ALARMAS_HISTORIAL=200
# Frenos anti-baneo del modo INMEDIATA (alarma de nueva factura en cuanto
# aparezca algo): minimo de segundos entre envios automaticos y topes totales
# por hora y por dia. Con los valores por defecto, como mucho 3 mensajes/hora y
# 12/dia, espaciados >= 15 min. REDUCIR si se nota actividad rara en WhatsApp.
ALARMAS_MIN_ESPACIO_S=900
ALARMAS_MAX_HORA=3
ALARMAS_MAX_DIA=12