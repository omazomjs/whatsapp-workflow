# ---- Conexion a SQL Server ----
# Si el servidor tiene instancia: SERVIDOR\INSTANCIA
DB_SERVER=192.168.1.212\SQL2008
DB_USER=wa_bot
# Si se deja VACIA, el worker la pide por consola al arrancar
DB_PASSWORD=
DB_DATABASE=GesMensajeria
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ---- Cola / polling ----
OUTBOX_TABLE=WhatsAppOutbox
POLL_INTERVAL_MS=30000
BATCH_SIZE=5

# ---- Fuente de datos (SOLO LECTURA) ----
# BD de negocio donde se leen los datos. El usuario DB_USER solo lee aqui.
# SRC_ENABLED=false -> el worker NO envia mensaje por factura (solo resumen diario)
SRC_ENABLED=false
SRC_DATABASE=REFact
SRC_TABLE=dbo.Registro
SRC_ID_COLUMN=IDRegistro
SRC_WHERE=
SRC_PHONE_COLUMN=Telefono
SRC_MESSAGE_TEMPLATE=

# ---- Resumen diario ----
RESUMEN_ENABLED=true
RESUMEN_HORA=23
RESUMEN_MINUTO=0
RESUMEN_RECIPIENTS=34660400537

# ---- WhatsApp ----
# Ruta de Chrome instalado (opcional; si no se indica, se usa el Chrome de Puppeteer)
WA_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Puerto para ver el QR en el navegador (0 = desactivado). Util en servidores sin terminal.
WA_QR_PORT=8080